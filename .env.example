# ============================================================
# PDF OCR Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and edit as needed.
# The backend loads these values at startup.
#
# Usage:
#   cp .env.example .env
#   # Edit .env, then:
#   cd backend && uvicorn main:app --reload
# ============================================================

# ------------------------------------------
# Parse quality thresholds
# ------------------------------------------

# Minimum number of alphanumeric+printable characters (after whitespace strip)
# required for a page to be considered directly parseable via PyMuPDF.
# Pages with fewer characters are sent to OCR.
MIN_TEXT_LENGTH=50

# Minimum proportion (0.0–1.0) of alphanumeric characters in extracted text.
# Pages where most chars are whitespace/garbage are sent to OCR.
MIN_ALPHANUMERIC_RATIO=0.4

# ------------------------------------------
# OCR settings
# ------------------------------------------

# DPI to use when rendering PDF pages to images for OCR.
# Higher DPI = better accuracy but more memory/time.
# Recommended range: 150–300.
OCR_DPI=200

# OpenOCR model mode:
#   mobile  — ONNX-based, fast, no GPU required (default)
#   server  — PyTorch-based, higher accuracy, requires: pip install torch torchvision
OPENOCR_MODE=mobile

# OpenOCR inference backend:
#   onnx    — No PyTorch needed (default)
#   torch   — Requires torch installation
OPENOCR_BACKEND=onnx

# Minimum detection box score (0.0–1.0).
# Boxes below this threshold are discarded by OpenOCR.
OPENOCR_DROP_SCORE=0.5

# ------------------------------------------
# Review threshold
# ------------------------------------------

# Pages with OCR confidence below this value are marked "needs_review".
# Valid range: 75–100. Default: 80.
# This threshold is DETERMINISTIC — no LLM or probabilistic model is involved.
OCR_REVIEW_THRESHOLD=80

# ------------------------------------------
# Storage
# ------------------------------------------

# Directory for temporary files (rendered page images, uploaded PDFs).
# Must be writable by the backend process.
TEMP_DIR=/tmp/ocr_pipeline

# Maximum PDF upload size in megabytes.
MAX_UPLOAD_MB=100

# ------------------------------------------
# Performance
# ------------------------------------------

# Number of OCR worker threads for parallel page processing.
# Set to 1 to disable parallelism (useful for debugging or low-memory machines).
MAX_OCR_WORKERS=2
